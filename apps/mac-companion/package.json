{
  "name": "@slz/mac-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "esbuild src/harness.ts --bundle --format=esm --platform=browser --outfile=public/harness.js && esbuild src/terminal.ts --bundle --format=esm --platform=browser --outfile=public/terminal.js",
    "build:harness": "pnpm run build:web",
    "dev": "pnpm run build:web && tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bonjour-service": "^1.3.0",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "node-pty": "^1.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.6.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
