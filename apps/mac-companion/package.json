{
  "name": "@slz/mac-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "node scripts/build-web.mjs --watch",
    "build:harness": "pnpm run build:web",
    "dev": "pnpm run start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "pnpm run build:transport && pnpm run build:windows && pnpm run build:web && tsx src/server.ts",
    "dev:watch": "pnpm run build:web && tsx watch src/server.ts",
    "build:transport": "node scripts/build-transport.mjs",
    "build:windows": "node scripts/build-windows.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "node-pty": "^1.1.0",
    "ws": "^8.18.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "^5.0.3",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.6.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
