{
  "manifest_version": 3,
  "name": "SlopZooka disposable browser probe",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "tabs", "nativeMessaging"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": {
    "default_title": "SlopZooka probe: click to stop control of this tab"
  }
}
