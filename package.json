{
  "name": "slopzooka",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "dev:companion": "pnpm --filter @slz/mac-companion dev",
    "build:harness": "pnpm --filter @slz/mac-companion build:harness",
    "typecheck": "pnpm --filter @slz/mac-companion typecheck",
    "test": "pnpm --filter @slz/mac-companion test",
    "setup:swiftlint": "node scripts/install-swiftlint.mjs",
    "lint": "pnpm lint:ts && pnpm lint:swift",
    "lint:ts": "eslint apps/mac-companion/src apps/mac-companion/test packages/protocol/src --max-warnings 0",
    "lint:swift": ".build/swiftlint/swiftlint lint --strict --config .swiftlint.yml && node scripts/test-swiftlint.mjs",
    "format": "prettier --write \"apps/mac-companion/src/**/*.ts\" \"apps/mac-companion/test/**/*.ts\" \"packages/protocol/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/mac-companion/src/**/*.ts\" \"apps/mac-companion/test/**/*.ts\" \"packages/protocol/src/**/*.ts\"",
    "build:mac-app": "node scripts/build-mac-app.mjs",
    "test:mac-app": "node scripts/test-mac-app.mjs",
    "test:vision-state": "node scripts/test-vision-state.mjs",
    "test:terminal-keyboard": "node scripts/test-terminal-keyboard.mjs",
    "test:native-video": "node scripts/test-native-video.mjs --hardware"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
